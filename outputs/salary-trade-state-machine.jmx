          <stringProp name="parameters">           </stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def runtimeFile = new File(&apos;C:/Users/DELL/Documents/Codex/2026-08-19/new-chat/outputs/AutoTest-AI/work/salary-trade-runtime.properties&apos;)
def isBlankOrPlaceholder = { value -&gt;
    value == null || !String.valueOf(value).trim() || String.valueOf(value).contains(&apos;${&apos;)
}
if (runtimeFile.exists()) {
    def runtimeProps = new Properties()
    def csvOwnedKeys = [
        &apos;applicant_uid&apos;,
        &apos;applicant_ticket&apos;,
        &apos;proxy_uid&apos;,
        &apos;agent_uid&apos;,
        &apos;proxy_ticket&apos;,
        &apos;proxy_ticket_uid&apos;,
        &apos;countryCode&apos;,
        &apos;currency&apos;,
        &apos;salaryAmount&apos;,
        &apos;bankReceiverName&apos;,
        &apos;swiftCode&apos;,
        &apos;bankName&apos;,
        &apos;bankAccount&apos;,
        &apos;bankReceiverAddress&apos;,
        &apos;bankReceiverPhone&apos;
    ] as Set
    runtimeFile.withInputStream { runtimeProps.load(it) }
    runtimeProps.each { k, v -&gt;
        def key = String.valueOf(k)
        def value = String.valueOf(v).trim()
        if (!isBlankOrPlaceholder(value)) {
            props.put(key, value)
            if (!csvOwnedKeys.contains(key) || isBlankOrPlaceholder(vars.get(key))) {
                vars.put(key, value)
            }
        }
    }
}
def pick = { key, fallback = &apos;&apos; -&gt;
    def value = vars.get(key) ?: props.get(key)
    if (isBlankOrPlaceholder(value)) value = fallback
    return String.valueOf(value ?: &apos;&apos;).trim()
}
def loadApplicantByFlow = {
    def flowName = ctx.getThreadGroup().getName()
    def flowIndex = null
    [
        &apos;流程A&apos;:0,
        &apos;流程B&apos;:1,
        &apos;流程C&apos;:2,
        &apos;流程D&apos;:3,
        &apos;流程E&apos;:4,
        &apos;流程F&apos;:5,
        &apos;流程G&apos;:6,
        &apos;流程H&apos;:7
    ].each { prefix, idx -&gt;
        if (flowIndex == null &amp;&amp; flowName.contains(prefix)) {
            flowIndex = idx
        }
    }
    if (flowIndex == null) return
    def csvPath = pick(&apos;salary_applicants_csv&apos;, &apos;C:/Users/DELL/Documents/Codex/2026-08-19/new-chat/outputs/AutoTest-AI/data/salary-trade-applicants.csv&apos;)
    def file = new File(csvPath)
    if (!file.exists()) {
        throw new IllegalStateException(&apos;申请人CSV不存在：&apos; + csvPath)
    }
    def parseLine = { line -&gt;
        def values = []
        def sb = new StringBuilder()
        boolean quoted = false
        for (int i = 0; i &lt; line.length(); i++) {
            char ch = line.charAt(i)
            if (ch == &apos;&quot;&apos; as char) {
                quoted = !quoted
            } else if (ch == &apos;,&apos; as char &amp;&amp; !quoted) {
                values &lt;&lt; sb.toString()
                sb.setLength(0)
            } else {
                sb.append(ch)
            }
        }
        values &lt;&lt; sb.toString()
        return values.collect { String.valueOf(it ?: &apos;&apos;).replace(&apos;&quot;&apos;,&apos;&apos;).trim() }
    }
    def lines = file.readLines(&apos;UTF-8&apos;).findAll { String.valueOf(it ?: &apos;&apos;).trim() }
    if (lines.size() &lt; flowIndex + 2) {
        throw new IllegalStateException(&apos;申请人CSV不足：&apos; + flowName + &apos; 需要第&apos; + (flowIndex + 1) + &apos;条申请人数据，当前只有&apos; + Math.max(0, lines.size() - 1) + &apos;条&apos;)
    }
    def headers = parseLine(lines[0])
    def values = parseLine(lines[flowIndex + 1])
    headers.eachWithIndex { name, idx -&gt;
        if (name) {
            def value = idx &lt; values.size() ? values[idx] : &apos;&apos;
            if (!isBlankOrPlaceholder(value)) {
                vars.put(name, value)
            }
        }
    }
}
loadApplicantByFlow()
def readRedisLine = { input -&gt;
    def out = new ByteArrayOutputStream()
    int b
    while ((b = input.read()) != -1) {
        if (b == 13) {
            input.read()
            break
        }
        out.write(b)
    }
    return out.toString(&apos;UTF-8&apos;)
}
def readRedisReply
readRedisReply = { input -&gt;
    int prefix = input.read()
    if (prefix == -1) throw new IllegalStateException(&apos;Redis连接已关闭&apos;)
    def line = readRedisLine(input)
    if (prefix == 45) throw new IllegalStateException(&apos;Redis错误：&apos; + line)
    if (prefix == 43 || prefix == 58) return line
    if (prefix == 36) {
        int len = Integer.parseInt(line)
        if (len &lt; 0) return &apos;&apos;
        byte[] bytes = new byte[len]
        int offset = 0
        while (offset &lt; len) {
            int n = input.read(bytes, offset, len - offset)
            if (n &lt;= 0) throw new IllegalStateException(&apos;Redis响应读取中断&apos;)
            offset += n
        }
        input.read(); input.read()
        return new String(bytes, &apos;UTF-8&apos;)
    }
    throw new IllegalStateException(&apos;不支持的Redis响应类型：&apos; + ((char) prefix))
}
def sendRedis = { socket, parts -&gt;
    def output = socket.getOutputStream()
    def payload = new StringBuilder(&apos;*&apos;).append(parts.size()).append(&apos;\r\n&apos;)
    parts.each { part -&gt;
        def bytes = String.valueOf(part).getBytes(&apos;UTF-8&apos;)
        payload.append(&apos;$&apos;).append(bytes.length).append(&apos;\r\n&apos;)
        payload.append(String.valueOf(part)).append(&apos;\r\n&apos;)
    }
    output.write(payload.toString().getBytes(&apos;UTF-8&apos;))
    output.flush()
    return readRedisReply(socket.getInputStream())
}
def fetchTicketFromRedis = { uid -&gt;
    if (isBlankOrPlaceholder(uid)) return &apos;&apos;
    def host = props.get(&apos;redis_host&apos;) ?: vars.get(&apos;redis_host&apos;) ?: &apos;${__P(redis_host,47.237.139.110)}&apos;
    def port = (props.get(&apos;redis_port&apos;) ?: vars.get(&apos;redis_port&apos;) ?: &apos;${__P(redis_port,6450)}&apos;) as int
    def db = (props.get(&apos;redis_db&apos;) ?: vars.get(&apos;redis_db&apos;) ?: &apos;${__P(redis_db,0)}&apos;) as int
    def password = props.get(&apos;redis_password&apos;) ?: vars.get(&apos;redis_password&apos;) ?: &apos;${__P(redis_password,)}&apos;
    def keyPrefix = props.get(&apos;redis_login_key_prefix&apos;) ?: vars.get(&apos;redis_login_key_prefix&apos;) ?: &apos;user_login_info:&apos;
    def socket = new Socket()
    socket.connect(new InetSocketAddress(host, port), 3000)
    socket.setSoTimeout(5000)
    try {
        if (password != null &amp;&amp; String.valueOf(password).trim()) {
            sendRedis(socket, [&apos;AUTH&apos;, String.valueOf(password).trim()])
        }
        if (db != 0) {
            sendRedis(socket, [&apos;SELECT&apos;, String.valueOf(db)])
        }
        return String.valueOf(sendRedis(socket, [&apos;HGET&apos;, keyPrefix + uid, &apos;access_token&apos;]) ?: &apos;&apos;).trim()
    } finally {
        socket.close()
    }
}
def jwtUid = { token -&gt;
    try {
        def parts = String.valueOf(token ?: &apos;&apos;).tokenize(&apos;.&apos;)
        if (parts.size() &lt; 2) return &apos;&apos;
        def payload = parts[1].replace(&apos;-&apos;, &apos;+&apos;).replace(&apos;_&apos;, &apos;/&apos;)
        while (payload.length() % 4 != 0) payload += &apos;=&apos;
        def json = new String(java.util.Base64.getDecoder().decode(payload), &apos;UTF-8&apos;)
        def parsed = new groovy.json.JsonSlurper().parseText(json)
        return String.valueOf(parsed.uid ?: &apos;&apos;).trim()
    } catch (Throwable ignored) {
        return &apos;&apos;
    }
}
def applicantUid = pick(&apos;applicant_uid&apos;, &apos;&apos;)
def redisApplicantTicket = &apos;&apos;
try {
    redisApplicantTicket = fetchTicketFromRedis(applicantUid)
} catch (Throwable ignored) {
    redisApplicantTicket = &apos;&apos;
}
def csvApplicantTicket = pick(&apos;applicant_ticket&apos;, vars.get(&apos;ticket&apos;) ?: props.get(&apos;ticket&apos;) ?: &apos;&apos;)
def applicantTicket = redisApplicantTicket ?: csvApplicantTicket
if (isBlankOrPlaceholder(applicantTicket)) {
    throw new IllegalStateException(&apos;工资交易未读取到申请人 ticket：请确认Redis user_login_info:&apos; + applicantUid + &apos;.access_token，或补充申请人CSV里的applicant_ticket&apos;)
}
def applicantTicketUid = jwtUid(applicantTicket)
if (applicantUid &amp;&amp; applicantTicketUid &amp;&amp; applicantTicketUid != applicantUid) {
    throw new IllegalStateException(&apos;申请人 uid 与 ticket 不匹配：applicant_uid=&apos; + applicantUid + &apos;, ticket_uid=&apos; + applicantTicketUid)
}
vars.put(&apos;applicant_ticket&apos;, applicantTicket)
props.put(&apos;applicant_ticket&apos;, applicantTicket)
vars.put(&apos;applicant_ticket_uid&apos;, applicantTicketUid)
props.put(&apos;applicant_ticket_uid&apos;, applicantTicketUid)
vars.put(&apos;ticket&apos;, applicantTicket)
props.put(&apos;ticket&apos;, applicantTicket)
