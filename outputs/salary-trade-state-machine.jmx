          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def required = [
    &apos;applicant_uid&apos;,
    &apos;applicant_ticket&apos;,
    &apos;currency&apos;,
    &apos;salaryAmount&apos;,
]

def missing = required.findAll { key -&gt;
    def value = vars.get(key) ?: props.get(key)
    value == null || String.valueOf(value).trim() == &apos;&apos; || String.valueOf(value).contains(&apos;${&apos;)
}

if (missing) {
    throw new IllegalStateException(
        &apos;创建订单前置变量缺失：&apos; + missing.join(&apos;, &apos;) +
        &apos;；请检查申请人CSV、JDBC代理查询、ticket和运行参数&apos;
    )
}

vars.put(&apos;ticket&apos;, vars.get(&apos;applicant_ticket&apos;) ?: props.get(&apos;applicant_ticket&apos;))
vars.put(&apos;agent_uid&apos;, vars.get(&apos;proxy_uid&apos;) ?: props.get(&apos;proxy_uid&apos;))
vars.put(&apos;uid&apos;, vars.get(&apos;applicant_uid&apos;) ?: props.get(&apos;applicant_uid&apos;))</stringProp>
