def loadApplicantByFlow = {
    def flowName = ctx.getThreadGroup().getName()
    def flowIndex = null
    [
        &apos;流程A&apos;:0,
        &apos;流程B&apos;:1,
        &apos;流程C&apos;:2,
        &apos;流程D&apos;:3,
        &apos;流程E&apos;:4,
        &apos;流程F&apos;:5,
        &apos;流程G&apos;:6,
        &apos;流程H&apos;:7
    ].each { prefix, idx -&gt;
        if (flowIndex == null &amp;&amp; flowName.contains(prefix)) {
            flowIndex = idx
        }
    }
    if (flowIndex == null) return
    def csvPath = pick(&apos;salary_applicants_csv&apos;, &apos;C:/Users/DELL/Documents/Codex/2026-08-19/new-chat/outputs/AutoTest-AI/data/salary-trade-applicants.csv&apos;)
    def file = new File(csvPath)
    if (!file.exists()) {
        throw new IllegalStateException(&apos;申请人CSV不存在：&apos; + csvPath)
    }
    def parseLine = { line -&gt;
        def values = []
        def sb = new StringBuilder()
        boolean quoted = false
        for (int i = 0; i &lt; line.length(); i++) {
            char ch = line.charAt(i)
            if (ch == &apos;&quot;&apos; as char) {
                quoted = !quoted
            } else if (ch == &apos;,&apos; as char &amp;&amp; !quoted) {
                values &lt;&lt; sb.toString()
                sb.setLength(0)
            } else {
                sb.append(ch)
            }
        }
        values &lt;&lt; sb.toString()
        return values.collect { String.valueOf(it ?: &apos;&apos;).replace(&apos;&quot;&apos;,&apos;&apos;).trim() }
    }
    def lines = file.readLines(&apos;UTF-8&apos;).findAll { String.valueOf(it ?: &apos;&apos;).trim() }
    if (lines.size() &lt; flowIndex + 2) {
        throw new IllegalStateException(&apos;申请人CSV不足：&apos; + flowName + &apos; 需要第&apos; + (flowIndex + 1) + &apos;条申请人数据，当前只有&apos; + Math.max(0, lines.size() - 1) + &apos;条&apos;)
    }
    def headers = parseLine(lines[0])
    def values = parseLine(lines[flowIndex + 1])
    headers.eachWithIndex { name, idx -&gt;
        if (name) {
            def value = idx &lt; values.size() ? values[idx] : &apos;&apos;
            if (!isBlankOrPlaceholder(value)) {
                vars.put(name, value)
            }
        }
    }
}
