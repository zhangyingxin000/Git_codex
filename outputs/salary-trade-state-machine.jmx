        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="同步数据库代理到工资交易变量" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def dbProxyCandidates = []
for (int i = 1; i &lt;= 10; i++) {
    def candidate = vars.get(&apos;db_proxy_uid_&apos; + i)
    if (candidate &amp;&amp; !String.valueOf(candidate).contains(&apos;${&apos;)) {
        dbProxyCandidates &lt;&lt; String.valueOf(candidate).trim()
    }
}
def singleCandidate = vars.get(&apos;db_proxy_uid&apos;)
if (!dbProxyCandidates &amp;&amp; singleCandidate &amp;&amp; !String.valueOf(singleCandidate).contains(&apos;${&apos;)) {
    dbProxyCandidates &lt;&lt; String.valueOf(singleCandidate).trim()
}
if (!dbProxyCandidates) {
    throw new IllegalStateException(&apos;数据库未匹配到可用代理：countryCode=&apos; + vars.get(&apos;countryCode&apos;) + &apos;, currency=&apos; + vars.get(&apos;currency&apos;) + &apos;，请检查 anchor_salary_trade_agent_whitelist&apos;)
}
def readRedisLine = { input -&gt;
    def out = new ByteArrayOutputStream()
    int b
    while ((b = input.read()) != -1) {
        if (b == 13) {
            input.read()
            break
        }
        out.write(b)
    }
    return out.toString(&apos;UTF-8&apos;)
}
def readRedisReply
readRedisReply = { input -&gt;
    int prefix = input.read()
    if (prefix == -1) throw new IllegalStateException(&apos;Redis连接已关闭&apos;)
    def line = readRedisLine(input)
    if (prefix == 45) throw new IllegalStateException(&apos;Redis错误：&apos; + line)
    if (prefix == 43 || prefix == 58) return line
    if (prefix == 36) {
        int len = Integer.parseInt(line)
        if (len &lt; 0) return &apos;&apos;
        byte[] bytes = new byte[len]
        int offset = 0
        while (offset &lt; len) {
            int n = input.read(bytes, offset, len - offset)
            if (n &lt;= 0) throw new IllegalStateException(&apos;Redis响应读取中断&apos;)
            offset += n
        }
        input.read(); input.read()
        return new String(bytes, &apos;UTF-8&apos;)
    }
    throw new IllegalStateException(&apos;不支持的Redis响应类型：&apos; + ((char) prefix))
}
def sendRedis = { socket, parts -&gt;
    def output = socket.getOutputStream()
    def payload = new StringBuilder(&apos;*&apos;).append(parts.size()).append(&apos;\r\n&apos;)
    parts.each { part -&gt;
        def bytes = String.valueOf(part).getBytes(&apos;UTF-8&apos;)
        payload.append(&apos;$&apos;).append(bytes.length).append(&apos;\r\n&apos;)
        payload.append(String.valueOf(part)).append(&apos;\r\n&apos;)
    }
    output.write(payload.toString().getBytes(&apos;UTF-8&apos;))
    output.flush()
    return readRedisReply(socket.getInputStream())
}
def fetchProxyTicketFromRedis = { uid -&gt;
    def host = props.get(&apos;redis_host&apos;) ?: vars.get(&apos;redis_host&apos;) ?: &apos;${__P(redis_host,47.237.139.110)}&apos;
    def port = (props.get(&apos;redis_port&apos;) ?: vars.get(&apos;redis_port&apos;) ?: &apos;${__P(redis_port,6450)}&apos;) as int
    def db = (props.get(&apos;redis_db&apos;) ?: vars.get(&apos;redis_db&apos;) ?: &apos;${__P(redis_db,0)}&apos;) as int
    def password = props.get(&apos;redis_password&apos;) ?: vars.get(&apos;redis_password&apos;) ?: &apos;${__P(redis_password,)}&apos;
    def keyPrefix = props.get(&apos;redis_login_key_prefix&apos;) ?: vars.get(&apos;redis_login_key_prefix&apos;) ?: &apos;user_login_info:&apos;
    def socket = new Socket()
    socket.connect(new InetSocketAddress(host, port), 3000)
    socket.setSoTimeout(5000)
    try {
        if (password != null &amp;&amp; String.valueOf(password).trim()) {
            sendRedis(socket, [&apos;AUTH&apos;, String.valueOf(password).trim()])
        }
        if (db != 0) {
            sendRedis(socket, [&apos;SELECT&apos;, String.valueOf(db)])
        }
        return String.valueOf(sendRedis(socket, [&apos;HGET&apos;, keyPrefix + uid, &apos;access_token&apos;]) ?: &apos;&apos;).trim()
    } finally {
        socket.close()
    }
}
def runtimeProxyTicket = &apos;&apos;
def selectedProxyUid = &apos;&apos;
def checkedProxyUids = []
def jwtUid = { token -&gt;
    try {
        def parts = String.valueOf(token ?: &apos;&apos;).tokenize(&apos;.&apos;)
        if (parts.size() &lt; 2) return &apos;&apos;
        def payload = parts[1].replace(&apos;-&apos;, &apos;+&apos;).replace(&apos;_&apos;, &apos;/&apos;)
        while (payload.length() % 4 != 0) payload += &apos;=&apos;
        def json = new String(java.util.Base64.getDecoder().decode(payload), &apos;UTF-8&apos;)
        def parsed = new groovy.json.JsonSlurper().parseText(json)
        return String.valueOf(parsed.uid ?: &apos;&apos;).trim()
    } catch (Throwable ignored) {
        return &apos;&apos;
    }
}
def skippedProxyReasons = []
dbProxyCandidates.each { candidateUid -&gt;
    if (!runtimeProxyTicket) {
        checkedProxyUids &lt;&lt; candidateUid
        def token = &apos;&apos;
        try {
            token = fetchProxyTicketFromRedis(candidateUid)
        } catch (Throwable ex) {
            skippedProxyReasons &lt;&lt; candidateUid + &apos;:Redis读取失败&apos;
        }
        if (token &amp;&amp; !String.valueOf(token).contains(&apos;${&apos;)) {
            def tokenUid = jwtUid(token)
            if (tokenUid == candidateUid) {
                selectedProxyUid = candidateUid
                runtimeProxyTicket = String.valueOf(token).trim()
                vars.put(&apos;proxy_ticket_uid&apos;, tokenUid)
                props.put(&apos;proxy_ticket_uid&apos;, tokenUid)
            } else {
                skippedProxyReasons &lt;&lt; candidateUid + &apos;:token_uid=&apos; + tokenUid
            }
        } else if (!skippedProxyReasons.find { String.valueOf(it).startsWith(candidateUid + &apos;:&apos;) }) {
            skippedProxyReasons &lt;&lt; candidateUid + &apos;:Redis无access_token&apos;
        }
    }
}
if (!runtimeProxyTicket) {
    throw new IllegalStateException(&apos;数据库已匹配候选代理 &apos; + checkedProxyUids.join(&apos;,&apos;) + &apos;，但Redis均未返回可用且uid匹配的登录态：&apos; + skippedProxyReasons.join(&apos;；&apos;))
}
vars.put(&apos;proxy_uid&apos;, selectedProxyUid)
vars.put(&apos;agent_uid&apos;, selectedProxyUid)
props.put(&apos;proxy_uid&apos;, selectedProxyUid)
props.put(&apos;agent_uid&apos;, selectedProxyUid)
vars.put(&apos;proxy_ticket&apos;, runtimeProxyTicket)
props.put(&apos;proxy_ticket&apos;, runtimeProxyTicket)
SampleResult.setResponseData((&apos;数据库代理匹配完成：&apos; + vars.get(&apos;countryCode&apos;) + &apos;/&apos; + vars.get(&apos;currency&apos;) + &apos; -&gt; proxy_uid=&apos; + vars.get(&apos;proxy_uid&apos;)).getBytes(&apos;UTF-8&apos;))</stringProp>
          <stringProp name="parameters"></stringProp>
