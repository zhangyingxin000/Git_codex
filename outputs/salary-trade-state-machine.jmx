      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="查询可用代理：按申请人国家和币种匹配白名单" enabled="true">
          <stringProp name="dataSource">salaryTradeMysql</stringProp>
          <stringProp name="queryType">Select Statement</stringProp>
          <stringProp name="query">SELECT uid AS db_proxy_uid,
       country_code AS db_proxy_country_code,
       support_currencies AS db_proxy_support_currencies
FROM anchor_salary_trade_agent_whitelist
WHERE status = 1
  AND FIND_IN_SET(&apos;${currency}&apos;, support_currencies) &gt; 0
ORDER BY CASE WHEN country_code = &apos;${countryCode}&apos; THEN 0 ELSE 1 END,
         id ASC
LIMIT 10</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames">db_proxy_uid,db_proxy_country_code,db_proxy_support_currencies</stringProp>
          <stringProp name="resultVariable">db_proxy_rows</stringProp>
          <stringProp name="queryTimeout">10</stringProp>
          <stringProp name="resultSetMaxRows">10</stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="同步数据库代理到工资交易变量" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def dbProxyCandidates = []
for (int i = 1; i &lt;= 10; i++) {
    def candidate = vars.get(&apos;db_proxy_uid_&apos; + i)
    if (candidate &amp;&amp; !String.valueOf(candidate).contains(&apos;${&apos;)) {
        dbProxyCandidates &lt;&lt; String.valueOf(candidate).trim()
    }
}
def singleCandidate = vars.get(&apos;db_proxy_uid&apos;)
if (!dbProxyCandidates &amp;&amp; singleCandidate &amp;&amp; !String.valueOf(singleCandidate).contains(&apos;${&apos;)) {
    dbProxyCandidates &lt;&lt; String.valueOf(singleCandidate).trim()
}
if (!dbProxyCandidates) {
    throw new IllegalStateException(&apos;数据库未匹配到可用代理：countryCode=&apos; + vars.get(&apos;countryCode&apos;) + &apos;, currency=&apos; + vars.get(&apos;currency&apos;) + &apos;，请检查 anchor_salary_trade_agent_whitelist&apos;)
}
def readRedisLine = { input -&gt;
    def out = new ByteArrayOutputStream()
    int b
    while ((b = input.read()) != -1) {
        if (b == 13) {
            input.read()
            break
        }
        out.write(b)
    }
    return out.toString(&apos;UTF-8&apos;)
}
def readRedisReply
readRedisReply = { input -&gt;
    int prefix = input.read()
    if (prefix == -1) throw new IllegalStateException(&apos;Redis连接已关闭&apos;)
    def line = readRedisLine(input)
    if (prefix == 45) throw new IllegalStateException(&apos;Redis错误：&apos; + line)
    if (prefix == 43 || prefix == 58) return line
    if (prefix == 36) {
        int len = Integer.parseInt(line)
        if (len &lt; 0) return &apos;&apos;
        byte[] bytes = new byte[len]
        int offset = 0
        while (offset &lt; len) {
            int n = input.read(bytes, offset, len - offset)
            if (n &lt;= 0) throw new IllegalStateException(&apos;Redis响应读取中断&apos;)
            offset += n
        }
        input.read(); input.read()
        return new String(bytes, &apos;UTF-8&apos;)
    }
    throw new IllegalStateException(&apos;不支持的Redis响应类型：&apos; + ((char) prefix))
}
def sendRedis = { socket, parts -&gt;
    def output = socket.getOutputStream()
    def payload = new StringBuilder(&apos;*&apos;).append(parts.size()).append(&apos;\r\n&apos;)
    parts.each { part -&gt;
        def bytes = String.valueOf(part).getBytes(&apos;UTF-8&apos;)
        payload.append(&apos;$&apos;).append(bytes.length).append(&apos;\r\n&apos;)
        payload.append(String.valueOf(part)).append(&apos;\r\n&apos;)
    }
    output.write(payload.toString().getBytes(&apos;UTF-8&apos;))
    output.flush()
    return readRedisReply(socket.getInputStream())
}
def fetchProxyTicketFromRedis = { uid -&gt;
