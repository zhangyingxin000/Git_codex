      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="流程I：公告与凭证维护接口（辅助流程）" enabled="true">
        <stringProp name="TestPlan.comments">状态机流程版：本线程组订单变量独立为 flow_i_order_no / flow_i_order_id，避免多流程并行时串单。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
