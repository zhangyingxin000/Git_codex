      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="流程A：创建 -&gt; 申请人取消（10 -&gt; 50）" enabled="true">
        <stringProp name="TestPlan.comments">状态机流程版：本线程组订单变量独立为 flow_a_order_no / flow_a_order_id，避免多流程并行时串单。</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
