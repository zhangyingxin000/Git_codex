          <hashTree />
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="从订单列表提取 orderId/orderNo/id" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters">             </stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def payload = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: '{}')
def found = null
def visit
visit = { obj -&gt;
    if (found != null || obj == null) return
    if (obj instanceof Map) {
        ['orderId','orderNo','tradeOrderId','id'].each { key -&gt;
            if (found == null &amp;&amp; obj[key] != null &amp;&amp; String.valueOf(obj[key]).trim()) found = obj[key]
        }
        obj.values().each { visit(it) }
    } else if (obj instanceof List) {
        obj.each { visit(it) }
    }
}
visit(payload?.data)
if (found != null) {
    vars.put('salary_order_id', String.valueOf(found))
    props.put('salary_order_id', String.valueOf(found))
}
vars.put('salary_order_id_found', found == null ? 'false' : 'true')</stringProp>
          </JSR223PostProcessor>
          <hashTree />
        </hashTree>
