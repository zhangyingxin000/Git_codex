].each { k, defaultValue -&gt;
    def value = pick(k, defaultValue)
    vars.put(k, value)
    props.put(k, value)
}
vars.put('agent_uid', vars.get('proxy_uid'))
props.put('agent_uid', vars.get('proxy_uid'))
SampleResult.setResponseData(('工资交易参数同步完成：申请人=' + vars.get('applicant_uid') + '，代理=' + vars.get('proxy_uid')).getBytes('UTF-8'))</stringProp>
