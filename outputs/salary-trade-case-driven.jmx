          <stringProp name="IfController.condition">${__groovy((vars.get('salary_order_id') ?: props.get('salary_order_id') ?: '').trim().length() &gt; 0,)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
