    ispType:'4',
    organic:'Organic'
].each { k, defaultValue -&gt;
    def value = pick(k, defaultValue)
    vars.put(k, value)
    props.put(k, value)
}
vars.put('agent_uid', vars.get('proxy_uid'))
props.put('agent_uid', vars.get('proxy_uid'))
SampleResult.setResponseData(('工资交易参数同步完成：申请人=' + vars.get('applicant_uid') + '，代理=' + vars.get('proxy_uid')).getBytes('UTF-8'))
SampleResult.setResponseData(('凭证自检通过：申请人ticket长度=' + vars.get('applicant_ticket').length() + '，代理ticket长度=' + vars.get('proxy_ticket').length()).getBytes('UTF-8'))</stringProp>
          <stringProp name="parameters">           </stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
