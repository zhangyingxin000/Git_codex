        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="工资交易业务流初始化：账号、金额、收款资料" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def runtimeFile = new File(&apos;C:/Users/DELL/Documents/Codex/2026-08-19/new-chat/outputs/AutoTest-AI/work/salary-trade-runtime.properties&apos;)
def isBlankOrPlaceholder = { value -&gt;
    value == null || !String.valueOf(value).trim() || String.valueOf(value).contains(&apos;${&apos;)
}
if (runtimeFile.exists()) {
    def runtimeProps = new Properties()
    runtimeFile.withInputStream { runtimeProps.load(it) }
    runtimeProps.each { k, v -&gt;
        if (!isBlankOrPlaceholder(v)) {
            props.put(String.valueOf(k), String.valueOf(v).trim())
            vars.put(String.valueOf(k), String.valueOf(v).trim())
        }
    }
}
def pick = { key, fallback = &apos;&apos; -&gt;
    def value = vars.get(key) ?: props.get(key)
    if (isBlankOrPlaceholder(value)) value = fallback
    return String.valueOf(value ?: &apos;&apos;).trim()
}
def applicantTicket = pick(&apos;applicant_ticket&apos;, vars.get(&apos;ticket&apos;) ?: props.get(&apos;ticket&apos;) ?: &apos;&apos;)
def proxyTicket = pick(&apos;proxy_ticket&apos;, &apos;&apos;)
if (isBlankOrPlaceholder(applicantTicket)) {
    throw new IllegalStateException(&apos;工资交易未读取到申请人 ticket：请用 open-salary-trade-only.ps1 传入 ApplicantTicket，或用 -Japplicant_ticket 传入&apos;)
}
if (isBlankOrPlaceholder(proxyTicket)) {
    throw new IllegalStateException(&apos;工资交易未读取到代理 ticket：请用 open-salary-trade-only.ps1 传入 ProxyTicket，或用 -Jproxy_ticket 传入&apos;)
}
vars.put(&apos;applicant_ticket&apos;, applicantTicket)
vars.put(&apos;proxy_ticket&apos;, proxyTicket)
props.put(&apos;applicant_ticket&apos;, applicantTicket)
props.put(&apos;proxy_ticket&apos;, proxyTicket)
vars.put(&apos;ticket&apos;, applicantTicket)
props.put(&apos;ticket&apos;, applicantTicket)
