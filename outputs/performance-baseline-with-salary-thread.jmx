        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="工资交易初始化：同步账号与公共参数" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def runtimeFile = new File(&apos;${__P(project_root,.)}/work/jmeter-runtime.properties&apos;)
if (runtimeFile.exists()) {
    def runtimeProps = new Properties()
    runtimeFile.withInputStream { runtimeProps.load(it) }
    runtimeProps.each { k, v -&gt;
        if (v != null &amp;&amp; String.valueOf(v).trim()) {
            props.put(String.valueOf(k), String.valueOf(v))
            vars.put(String.valueOf(k), String.valueOf(v))
        }
    }
}
def token = props.get(&apos;ticket&apos;) ?: vars.get(&apos;ticket&apos;) ?: &apos;${__P(ticket,)}&apos;
if (!token) {
    throw new IllegalStateException(&apos;工资交易读接口未取得 ticket，请先运行登录前置或通过 -Jticket 传入&apos;)
}
vars.put(&apos;ticket&apos;, token)
props.put(&apos;ticket&apos;, token)
def agentToken = props.get(&apos;proxy_ticket&apos;) ?: vars.get(&apos;proxy_ticket&apos;) ?: &apos;${__P(proxy_ticket,)}&apos;
if (agentToken &amp;&amp; !agentToken.contains(&apos;${&apos;)) {
    vars.put(&apos;proxy_ticket&apos;, agentToken)
    props.put(&apos;proxy_ticket&apos;, agentToken)
}
[
  applicant_uid:&apos;1454428&apos;,
  agent_uid:&apos;1454924&apos;,
  countryCode:&apos;EG&apos;,
  currency:&apos;EGP&apos;,
  pageNo:&apos;1&apos;,
  pageSize:&apos;20&apos;,
  deviceId:&apos;apipost-anchor-device&apos;,
  model:&apos;SM-A546B&apos;,
  osVersion:&apos;16&apos;,
  appVersion:&apos;100.1.5.6&apos;,
  version:&apos;100.1.5.6&apos;
].each { k,v -&gt;
    def fromProperty = props.get(k) ?: vars.get(k) ?: v
    vars.put(k, String.valueOf(fromProperty))
    props.put(k, String.valueOf(fromProperty))
}
SampleResult.setResponseData((&apos;工资交易参数已同步：申请人=&apos; + vars.get(&apos;applicant_uid&apos;) + &apos;, 代理=&apos; + vars.get(&apos;agent_uid&apos;)).getBytes(&apos;UTF-8&apos;))</stringProp>
