            <stringProp name="script">import groovy.json.JsonSlurper
def payload = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: &apos;{}&apos;)
def status = payload?.data?.status ?: payload?.data?.order?.status
if (String.valueOf(status) != &apos;10&apos;) {
    throw new IllegalStateException(&apos;创建订单 状态不符合预期：期望 10，实际 &apos; + status)
}
SampleResult.setResponseData((&apos;创建订单 状态断言通过：&apos; + status).getBytes(&apos;UTF-8&apos;))</stringProp>
