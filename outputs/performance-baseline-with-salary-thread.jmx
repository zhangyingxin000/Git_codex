            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def payload = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: &apos;{}&apos;)
def value = payload?.data?.status ?: payload?.data?.order?.status
if (String.valueOf(value) != &apos;10&apos;) {
    throw new IllegalStateException(&apos;创建订单 状态不符合预期：期望 10，实际 &apos; + value)
}</stringProp>
