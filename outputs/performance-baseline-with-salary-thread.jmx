        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="工资交易业务流初始化：账号、金额、收款资料" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def runtimeFile = new File(&apos;${__P(project_root,.)}/work/jmeter-runtime.properties&apos;)
if (runtimeFile.exists()) {
    def runtimeProps = new Properties()
    runtimeFile.withInputStream { runtimeProps.load(it) }
    runtimeProps.each { k, v -&gt;
        if (v != null &amp;&amp; String.valueOf(v).trim()) {
            props.put(String.valueOf(k), String.valueOf(v))
            vars.put(String.valueOf(k), String.valueOf(v))
        }
    }
}
def token = props.get(&apos;ticket&apos;) ?: vars.get(&apos;ticket&apos;) ?: &apos;${__P(ticket,)}&apos;
if (!token) throw new IllegalStateException(&apos;未取得申请人 ticket，无法创建工资订单&apos;)
vars.put(&apos;ticket&apos;, token)
props.put(&apos;ticket&apos;, token)
def proxyTicket = props.get(&apos;proxy_ticket&apos;) ?: vars.get(&apos;proxy_ticket&apos;) ?: &apos;${__P(proxy_ticket,)}&apos;
if (!proxyTicket) throw new IllegalStateException(&apos;未取得代理用户 ticket：严格校验下代理接口必须使用代理账号登录态&apos;)
vars.put(&apos;proxy_ticket&apos;, proxyTicket)
[
  applicant_uid:&apos;${__P(applicant_uid,1454428)}&apos;,
  agent_uid:&apos;${__P(agent_uid,1454924)}&apos;,
  countryCode:&apos;${__P(countryCode,EG)}&apos;,
  currency:&apos;${__P(currency,EGP)}&apos;,
  salaryAmount:&apos;${__P(salaryAmount,50)}&apos;,
  localPayAmount:&apos;${__P(localPayAmount,188)}&apos;,
  exchangeRate:&apos;${__P(exchangeRate,3.76)}&apos;,
  bankReceiverName:&apos;${__P(bankReceiverName,Payee Name)}&apos;,
  swiftCode:&apos;${__P(swiftCode,ABCDEF12)}&apos;,
  bankName:&apos;${__P(bankName,Example Bank)}&apos;,
  bankAccount:&apos;${__P(bankAccount,SA1234567890)}&apos;,
  bankReceiverAddress:&apos;${__P(bankReceiverAddress,Riyadh Address)}&apos;,
  bankReceiverPostalCode:&apos;${__P(bankReceiverPostalCode,12345)}&apos;,
  bankReceiverPhone:&apos;${__P(bankReceiverPhone,+966500000000)}&apos;,
  bankReceiverEmail:&apos;${__P(bankReceiverEmail,payee@example.com)}&apos;,
  payProofUrls:&apos;${__P(payProofUrls,https://example.com/pay-proof.jpg)}&apos;,
  appealEvidenceUrls:&apos;${__P(appealEvidenceUrls,https://example.com/appeal-proof.jpg)}&apos;,
  pageNo:&apos;1&apos;,
  pageSize:&apos;20&apos;,
  deviceId:&apos;apipost-anchor-device&apos;,
  model:&apos;SM-A546B&apos;,
  osVersion:&apos;16&apos;,
  appVersion:&apos;100.1.5.6&apos;,
  version:&apos;100.1.5.6&apos;
].each { k,v -&gt; vars.put(k, String.valueOf(v)); props.put(k, String.valueOf(v)) }
SampleResult.setResponseData((&apos;工资交易业务流初始化完成，申请人=&apos;+vars.get(&apos;applicant_uid&apos;)+&apos;，代理=&apos;+vars.get(&apos;agent_uid&apos;)).getBytes(&apos;UTF-8&apos;))</stringProp>
