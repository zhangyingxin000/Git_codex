            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def payload = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: &apos;{}&apos;)
def found = null
def visit
visit = { obj -&gt;
    if (found != null || obj == null) return
    if (obj instanceof Map) {
        [&apos;orderId&apos;,&apos;orderNo&apos;,&apos;tradeOrderId&apos;,&apos;id&apos;].each { key -&gt;
            if (found == null &amp;&amp; obj[key] != null &amp;&amp; String.valueOf(obj[key]).trim()) found = obj[key]
        }
        obj.values().each { visit(it) }
    } else if (obj instanceof List) {
        obj.each { visit(it) }
    }
}
visit(payload?.data)
if (found != null) {
    vars.put(&apos;salary_order_id&apos;, String.valueOf(found))
    props.put(&apos;salary_order_id&apos;, String.valueOf(found))
}
vars.put(&apos;salary_order_id_found&apos;, found == null ? &apos;false&apos; : &apos;true&apos;)</stringProp>
          </JSR223PostProcessor>
