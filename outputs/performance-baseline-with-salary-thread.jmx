          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="同步工资订单号" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def orderNo = vars.get(&apos;salary_order_no&apos;)
if (!orderNo) {
    throw new IllegalStateException(&apos;创建订单未返回 orderNo，后续状态流转无法执行&apos;)
}
props.put(&apos;salary_order_no&apos;, orderNo)
vars.put(&apos;salary_order_id&apos;, orderNo)
props.put(&apos;salary_order_id&apos;, orderNo)</stringProp>
