            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def orderNo = vars.get(&apos;salary_order_no&apos;)
if (!orderNo) throw new IllegalStateException(&apos;创建订单未返回 orderNo&apos;)
