<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="同步 ticket 到业务线程组" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">def token = vars.get(&apos;access_token&apos;)
if (token) {
    props.put(&apos;ticket&apos;, token)
    vars.put(&apos;ticket&apos;, token)
}
def loginUid = vars.get(&apos;login_uid&apos;)
if (loginUid) {
    props.put(&apos;uid&apos;, loginUid)
    vars.put(&apos;uid&apos;, loginUid)
}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PostProcessor>
