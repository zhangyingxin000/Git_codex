<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="闭环初始化：清空本次消费累计" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">props.put(&apos;gift_total_consume&apos;,&apos;0&apos;)
props.put(&apos;gift_success_count&apos;,&apos;0&apos;)
props.put(&apos;gift_consume_values&apos;,&apos;&apos;)
props.put(&apos;gift_bill_match_count&apos;,&apos;0&apos;)
vars.put(&apos;workflow_expected_gift_count&apos;,&apos;10&apos;)</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Sampler>
<hashTree>

</hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="读取登录身份上下文" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">def token = props.get(&apos;ticket&apos;) ?: vars.get(&apos;ticket&apos;) ?: &apos;${__P(ticket,)}&apos;
if (!token) {
    throw new IllegalStateException(&apos;未取得 ticket：请先通过平台传入登录密码打开 JMeter，或复用平台已保存 ticket&apos;)
}
vars.put(&apos;ticket&apos;, token)
def loginUid = props.get(&apos;uid&apos;) ?: vars.get(&apos;uid&apos;) ?: &apos;${__P(uid,)}&apos;
if (loginUid) {
    vars.put(&apos;uid&apos;, loginUid)
}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor>
<hashTree>

</hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="前置查询财富等级快照" enabled="true">
<elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
<collectionProp name="Arguments.arguments"/>
