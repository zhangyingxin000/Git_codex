<hashTree>
<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="检查 JMeter 运行凭证是否注入" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def runtimeFile = new File(&apos;${__P(project_root,.)}/work/salary-trade-runtime.properties&apos;)
def isBlankOrPlaceholder = { value -&gt;
    value == null || !String.valueOf(value).trim() || String.valueOf(value).contains(&apos;${&apos;)
}
if (runtimeFile.exists()) {
    def runtimeProps = new Properties()
    runtimeFile.withInputStream { runtimeProps.load(it) }
    runtimeProps.each { k, v -&gt;
        if (!isBlankOrPlaceholder(v)) {
            props.put(String.valueOf(k), String.valueOf(v).trim())
            vars.put(String.valueOf(k), String.valueOf(v).trim())
        }
    }
}
def pick = { key, fallback = &apos;&apos; -&gt;
    def value = vars.get(key) ?: props.get(key)
    if (isBlankOrPlaceholder(value)) value = fallback
    return String.valueOf(value ?: &apos;&apos;).trim()
}
def applicantTicket = pick(&apos;applicant_ticket&apos;, vars.get(&apos;ticket&apos;) ?: props.get(&apos;ticket&apos;) ?: &apos;&apos;)
def proxyTicket = pick(&apos;proxy_ticket&apos;, &apos;&apos;)
// 工资交易代理CSV动态匹配：按申请人的收款币种筛选代理；同国家优先，没有则回退到所有支持该币种的代理。
def proxyUid = pick(&apos;proxy_uid&apos;, &apos;&apos;)
if (isBlankOrPlaceholder(proxyTicket) || isBlankOrPlaceholder(proxyUid)) {
    def proxyCsvPath = pick(&apos;salary_proxies_csv&apos;, &apos;${__P(project_root,.)}/data/salary-trade-proxies.csv&apos;)
    def proxyCsvFile = new File(proxyCsvPath)
    if (!proxyCsvFile.isFile()) {
        throw new IllegalStateException(&apos;代理CSV不存在：&apos; + proxyCsvPath)
    }
    def parseCsvLine = { line -&gt;
        def values = []
        def current = new StringBuilder()
        boolean quoted = false
        for (int i = 0; i &lt; line.length(); i++) {
            char ch = line.charAt(i)
            if (ch == ((char) 34)) {
                if (quoted &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == ((char) 34)) {
                    current.append((char) 34)
                    i++
                } else {
                    quoted = !quoted
                }
            } else if (ch == ((char) 44) &amp;&amp; !quoted) {
                values.add(current.toString())
                current.setLength(0)
            } else {
                current.append(ch)
            }
        }
        values.add(current.toString())
        return values
    }
    def lines = proxyCsvFile.readLines(&apos;UTF-8&apos;).findAll { it != null &amp;&amp; it.trim() }
    if (lines.size() &lt; 2) {
        throw new IllegalStateException(&apos;代理CSV没有可用数据：&apos; + proxyCsvPath)
    }
    def headers = parseCsvLine(lines[0]).collect { it.replace(&apos;﻿&apos;, &apos;&apos;).trim() }
    def requestedCurrency = pick(&apos;currency&apos;, &apos;&apos;).toUpperCase()
    def requestedCountry = pick(&apos;countryCode&apos;, &apos;&apos;).toUpperCase()
    def candidates = []
    lines.drop(1).each { line -&gt;
        def values = parseCsvLine(line)
        def row = [:]
        headers.eachWithIndex { header, index -&gt;
            row[header] = index &lt; values.size() ? String.valueOf(values[index]).trim() : &apos;&apos;
        }
        def enabled = !row.containsKey(&apos;enabled&apos;) || row.enabled.equalsIgnoreCase(&apos;true&apos;) || row.enabled == &apos;1&apos;
        def active = !row.containsKey(&apos;status&apos;) || row.status == &apos;1&apos;
        def supported = String.valueOf(row.supportCurrencies ?: row.support_currencies ?: &apos;&apos;)
            .split(&apos;,&apos;).collect { it.trim().toUpperCase() }
        def uid = String.valueOf(row.proxy_uid ?: row.uid ?: &apos;&apos;).trim()
        def ticket = String.valueOf(row.proxy_ticket ?: row.ticket ?: &apos;&apos;).trim()
        def tokenParts = ticket.tokenize(&apos;.&apos;)
        def tokenUid = &apos;&apos;
        if (tokenParts.size() == 3) {
            try {
                def payload = new groovy.json.JsonSlurper().parseText(new String(java.util.Base64.getUrlDecoder().decode(tokenParts[1]), &apos;UTF-8&apos;))
                tokenUid = String.valueOf(payload.uid ?: &apos;&apos;)
            } catch (ignored) {
                tokenUid = &apos;&apos;
            }
        }
        if (enabled &amp;&amp; active &amp;&amp; uid &amp;&amp; ticket &amp;&amp; uid == tokenUid &amp;&amp; supported.contains(requestedCurrency)) {
            row[&apos;resolved_uid&apos;] = uid
            row[&apos;resolved_ticket&apos;] = ticket
            candidates.add(row)
        }
    }
    if (!candidates) {
        throw new IllegalStateException(&apos;代理CSV未匹配到可用账号：currency=&apos; + requestedCurrency + &apos;，csv=&apos; + proxyCsvPath)
    }
    def sameCountry = candidates.findAll { String.valueOf(it.countryCode ?: it.country_code ?: &apos;&apos;).trim().equalsIgnoreCase(requestedCountry) }
    def pool = sameCountry ?: candidates
    def selector = pick(&apos;applicant_uid&apos;, &apos;&apos;) + &apos;|&apos; + ctx.getThreadNum() + &apos;|&apos; + ctx.getThreadGroup().getName()
    def selected = pool[Math.floorMod(selector.hashCode(), pool.size())]
    proxyUid = String.valueOf(selected.resolved_uid)
    proxyTicket = String.valueOf(selected.resolved_ticket)
    vars.put(&apos;proxy_uid&apos;, proxyUid)
    vars.put(&apos;proxy_ticket&apos;, proxyTicket)
    vars.put(&apos;proxy_countryCode&apos;, String.valueOf(selected.countryCode ?: selected.country_code ?: &apos;&apos;))
    vars.put(&apos;proxy_supportCurrencies&apos;, String.valueOf(selected.supportCurrencies ?: selected.support_currencies ?: &apos;&apos;))
}
if (isBlankOrPlaceholder(proxyUid)) {
    throw new IllegalStateException(&apos;工资交易未读取到代理 uid：请检查代理CSV&apos;)
}
if (isBlankOrPlaceholder(applicantTicket)) {
    throw new IllegalStateException(&apos;工资交易未读取到申请人 ticket：请用 open-salary-trade-only.ps1 传入 ApplicantTicket，或用 -Japplicant_ticket 传入&apos;)
}
if (isBlankOrPlaceholder(proxyTicket)) {
    throw new IllegalStateException(&apos;工资交易未读取到代理 ticket：请用 open-salary-trade-only.ps1 传入 ProxyTicket，或用 -Jproxy_ticket 传入&apos;)
}
vars.put(&apos;applicant_ticket&apos;, applicantTicket)
vars.put(&apos;proxy_ticket&apos;, proxyTicket)
props.put(&apos;applicant_ticket&apos;, applicantTicket)
props.put(&apos;proxy_ticket&apos;, proxyTicket)
vars.put(&apos;ticket&apos;, applicantTicket)
props.put(&apos;ticket&apos;, applicantTicket)
[
    applicant_uid:&apos;1454696&apos;,
    proxy_uid:&apos;&apos;,
    agent_uid:&apos;&apos;,
    countryCode:&apos;MA&apos;,
    currency:&apos;USD&apos;,
    salaryAmount:&apos;100&apos;,
    localPayAmount:&apos;0&apos;,
    exchangeRate:&apos;0&apos;,
    bankReceiverName:&apos;Sarly&apos;,
    swiftCode:&apos;SWIFT&apos;,
    bankName:&apos;EGbank&apos;,
    bankAccount:&apos;872819994964648929003773773&apos;,
    bankReceiverAddress:&apos;salary trade autotest address&apos;,
    bankReceiverPostalCode:&apos;&apos;,
    bankReceiverPhone:&apos;0845513616949&apos;,
    bankReceiverEmail:&apos;&apos;,
    payProofUrls:&apos;https://example.com/pay-proof.jpg&apos;,
    appealEvidenceUrls:&apos;https://example.com/appeal-proof.jpg&apos;,
    pageNo:&apos;1&apos;,
    pageSize:&apos;20&apos;,
    deviceType:&apos;0&apos;,
    systemLanguage:&apos;zh&apos;,
    appVersion:&apos;100.1.5.6&apos;,
    os:&apos;android&apos;,
    netType:&apos;2&apos;,
    channel:&apos;google&apos;,
    appsflyerId:&apos;1787803900487-1623248308013165548&apos;,
    language:&apos;ar&apos;,
    appCode:&apos;100156&apos;,
    deviceId:&apos;8fcce1f1-5153-3207-9786-0240140a524a&apos;,
    version:&apos;100.1.5.6&apos;,
    osVersion:&apos;16&apos;,
    isVpnConnected:&apos;0&apos;,
    appid:&apos;soulfree&apos;,
    model:&apos;SM-A546B&apos;,
    packageName:&apos;com.soulfree.happiness&apos;,
    ispType:&apos;4&apos;,
    organic:&apos;Organic&apos;
].each { k, defaultValue -&gt;
    def value = pick(k, defaultValue)
    vars.put(k, value)
    props.put(k, value)
}
vars.put(&apos;agent_uid&apos;, vars.get(&apos;proxy_uid&apos;))
props.put(&apos;agent_uid&apos;, vars.get(&apos;proxy_uid&apos;))
SampleResult.setResponseData((&apos;工资交易参数同步完成：申请人=&apos; + vars.get(&apos;applicant_uid&apos;) + &apos;，代理=&apos; + vars.get(&apos;proxy_uid&apos;)).getBytes(&apos;UTF-8&apos;))
SampleResult.setResponseData((&apos;凭证自检通过：申请人ticket长度=&apos; + vars.get(&apos;applicant_ticket&apos;).length() + &apos;，代理ticket长度=&apos; + vars.get(&apos;proxy_ticket&apos;).length()).getBytes(&apos;UTF-8&apos;))</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp></JSR223Sampler>
