<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="投诉后申请人详情：断言订单状态 80" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">import groovy.json.JsonSlurper
