def payload = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: &apos;{}&apos;)
def value = payload?.data?.status ?: payload?.data?.order?.status
if (String.valueOf(value) != &apos;20&apos;) {
    throw new IllegalStateException(&apos;代理接单 状态不符合预期：期望 20，实际 &apos; + value)
}</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp></JSR223Sampler>
