# 复制为 database.env，集中填写数据库连接配置。
# 不要提交包含真实密码的文件。
AUTOTEST_DB_TYPE=mysql
AUTOTEST_DB_HOST=127.0.0.1
AUTOTEST_DB_PORT=3306
AUTOTEST_DB_NAME=your_test_database
AUTOTEST_DB_USER=autotest_readonly
AUTOTEST_DB_PASSWORD=replace_me
AUTOTEST_DB_MODE=readonly

# API secrets are also injected only at runtime. Never commit real values.
AUTOTEST_HEADER_SN=replace_me
AUTOTEST_HEADER_AUTHORIZATION=
AUTOTEST_ALLOW_MUTATIONS=true
AUTOTEST_ALLOW_HIGH_RISK=true
AUTOTEST_ALLOWED_HOSTS=test2westarlive.gzxchate.com
